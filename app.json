{
  "expo": {
    "name": "مبيان فيجن",
    "slug": "mata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "مبيان فيجن يحتاج المايك عشان تكلم المساعد.",
        "NSBluetoothAlwaysUsageDescription": "مبيان فيجن يتصل بالنظارة عبر البلوتوث.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mubayan.vision"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "مبيان فيجن يستخدم الكاميرا عشان يشوف ويوصف لك اللي حولك.",
          "microphonePermission": "مبيان فيجن يحتاج المايك عشان تكلمه."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "مبيان فيجن يحتاج المايك عشان تكلمه."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.2"
          }
        }
      ],
      [
        "./plugins/with-meta-wearables",
        {
          "urlScheme": "mata"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99fbfd91-a4b6-454a-98ab-15eb7d940cb3"
      }
    },
    "owner": "faisal619"
  }
}
