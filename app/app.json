{
  "expo": {
    "name": "مبيان فيجن",
    "slug": "mata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "buildNumber": "3",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "مبيان فيجن يحتاج المايك عشان تكلم المساعد.",
        "NSBluetoothAlwaysUsageDescription": "مبيان فيجن يتصل بالنظارة عبر البلوتوث.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mubayan.mibyanvision"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFAFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "مبيان فيجن يستخدم الكاميرا عشان يشوف ويوصف لك اللي حولك.",
          "microphonePermission": "مبيان فيجن يحتاج المايك عشان تكلمه."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "مبيان فيجن يحتاج المايك عشان تكلمه.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.2"
          }
        }
      ],
      [
        "./plugins/with-meta-wearables",
        {
          "urlScheme": "mata"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "مبيان فيجن يستخدم موقعك عشان يقولك وين أنت ويحدد اتجاه القبلة."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "./plugins/with-shortcuts",
        {
          "alternativeNames": [
            "مبيان",
            "Mubayan"
          ]
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": false,
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ],
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "103efad3-da41-440c-9eae-1e52142d07af"
      }
    },
    "owner": "falah_11"
  }
}
